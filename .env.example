# Copy to .env and fill with YOUR OWN separate test project values.
# Never use production values. Leaving these as placeholders means the app cannot reach any database.
VITE_SUPABASE_URL="https://your-test-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_test_key"
VITE_SUPABASE_PROJECT_ID="your-test-project-ref"
SUPABASE_URL="https://your-test-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_test_key"
# Server-only secrets (never commit real values):
SUPABASE_SERVICE_ROLE_KEY="your-test-service-role-key"
LOVABLE_API_KEY="your-own-lovable-ai-gateway-key"
# Used only by drizzle-kit to apply migrations to the TEST database:
LOVABLE_DB_MIGRATION_URL="postgresql://postgres:password@localhost:54322/postgres"
